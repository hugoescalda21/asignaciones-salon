rules_version = '2';

// Reglas de seguridad — Asignaciones del Salón del Reino
// -----------------------------------------------------------------
// Cómo instalarlas (desde la carpeta push-salon-2026):
//   firebase deploy --only firestore:rules,storage
// (También se puede pegar este archivo a mano en la consola de
// Firebase → Firestore Database → Reglas → Publicar.)
//
// Qué cambia respecto a las reglas actuales (que dejaban leer y
// escribir a cualquiera): ahora hace falta haber iniciado sesión
// (con el link por correo) Y que tu email esté en alguna de las
// listas de acceso de esa congregación en particular.
//
// "editorEmails"              = Super Admin (ven y editan todo).
// "tecnicoAdminEmails"        = Admin de Equipo técnico.
// "acomodadoresAdminEmails"   = Admin de Acomodadores.
// "asignacionesAdminEmails"   = Admin de Asignaciones (Programa).
// "anunciosOnlyEmails"         = Solo anuncios (publican anuncios y nada más).
// "anunciosEmails"             = permiso extra "Puede publicar anuncios"
//                                para cualquiera de los tres Admin.
// "viewerEmails"               = solo pueden ver (ver.html).
//
// Qué controla el servidor: quién publica anuncios y quién puede
// cambiar las listas de acceso (solo Super Admin). Por lo demás, un
// Admin todavía puede escribir asignaciones de otras áreas — es la
// interfaz la que le oculta lo que no le corresponde. Eso sigue
// anotado en el roadmap del proyecto.
//
// El primer email que crea una congregación nueva se agrega solo
// a "editorEmails" — así el que arma la congregación no queda
// afuera de su propia base.

service cloud.firestore {
  match /databases/{database}/documents {
    match /congregations/{code} {

      // Crear una congregación nueva: solo hace falta estar logueado.
      // La propia app agrega automáticamente el email de quien la
      // crea a editorEmails en el mismo momento de guardarla.
      allow create: if request.auth != null
                    && request.auth.token.email in request.resource.data.settings.editorEmails;

      function mail() { return request.auth.token.email; }
      function lista(campo) { return resource.data.settings.get(campo, []); }
      function sinEditores() { return lista('editorEmails').size() == 0; }
      function esSuper() { return mail() in lista('editorEmails') || sinEditores(); }
      function esAdmin() {
        return mail() in lista('tecnicoAdminEmails') ||
               mail() in lista('acomodadoresAdminEmails') ||
               mail() in lista('asignacionesAdminEmails');
      }
      function esSoloAnuncios() { return mail() in lista('anunciosOnlyEmails'); }
      function puedeAnuncios() { return esSuper() || esSoloAnuncios() || mail() in lista('anunciosEmails'); }
      // Los anuncios quedan igual que estaban.
      function anunciosSinCambios() {
        return request.resource.data.get('anuncios', []) == resource.data.get('anuncios', []);
      }
      // Las listas de acceso (roles y permiso de anuncios) quedan igual:
      // solo un Super Admin las puede cambiar.
      function accesoSinCambios() {
        let antes = resource.data.settings;
        let despues = request.resource.data.settings;
        return despues.get('editorEmails', []) == antes.get('editorEmails', []) &&
               despues.get('tecnicoAdminEmails', []) == antes.get('tecnicoAdminEmails', []) &&
               despues.get('acomodadoresAdminEmails', []) == antes.get('acomodadoresAdminEmails', []) &&
               despues.get('asignacionesAdminEmails', []) == antes.get('asignacionesAdminEmails', []) &&
               despues.get('anunciosOnlyEmails', []) == antes.get('anunciosOnlyEmails', []) &&
               despues.get('anunciosEmails', []) == antes.get('anunciosEmails', []) &&
               despues.get('viewerEmails', []) == antes.get('viewerEmails', []);
      }

      // Leer: logueado, y el email tiene que estar en alguna de las
      // listas de acceso de ESA congregación puntual — o la
      // congregación todavía no tiene ningún editor cargado (caso de
      // una congregación que ya existía antes de este sistema de
      // login, donde el campo puede ni siquiera existir todavía —
      // por eso .get(..., []) en vez de leerlo directo, que se rompe
      // si el campo no está).
      allow read: if request.auth != null && (
                    esSuper() || esAdmin() || esSoloAnuncios() ||
                    mail() in lista('viewerEmails')
                  );

      // Editar:
      //  · Super Admin (o congregación sin editores todavía): todo.
      //  · Admins (técnico / acomodadores / asignaciones): todo menos
      //    las listas de acceso; y los anuncios solo si tienen el
      //    permiso "Puede publicar anuncios" (anunciosEmails).
      //  · "Solo anuncios": únicamente el campo de anuncios.
      allow update: if request.auth != null && (
                    esSuper() ||
                    (esAdmin() && accesoSinCambios() && (puedeAnuncios() || anunciosSinCambios())) ||
                    (esSoloAnuncios() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anuncios']))
                  );

      // Nunca se borra una congregación completa desde la app.
      allow delete: if false;
    }

    // Notificaciones push — un documento por celular/token, para
    // avisar por asignación nueva. Separado del documento principal
    // a propósito: así no hace falta tocar las reglas de arriba, y
    // cualquier persona logueada (ya haya pasado el control de
    // acceso de su congregación) puede registrar o borrar su propio
    // token sin exponer nada del resto de los datos.
    match /pushSubscriptions/{token} {
      allow read: if false; // solo la función en la nube los lee (con permisos de administrador, salta las reglas)
      allow write: if request.auth != null
                   && request.resource.data.keys().hasAll(['code', 'pubId'])
                   && request.resource.data.code is string
                   && request.resource.data.pubId is string;
      allow delete: if request.auth != null;
    }
  }
}
