rules_version = '2';

// Reglas de seguridad — Asignaciones del Salón del Reino
// -----------------------------------------------------------------
// Cómo instalarlas (desde la carpeta push-salon-2026):
//   firebase deploy --only firestore:rules,storage
// (También se puede pegar este archivo a mano en la consola de
// Firebase → Firestore Database → Reglas → Publicar.)
//
// Qué cambia respecto a las reglas actuales (que dejaban leer y
// escribir a cualquiera): ahora hace falta haber iniciado sesión
// (con el link por correo) Y que tu email esté en alguna de las
// listas de acceso de esa congregación en particular.
//
// "editorEmails"              = Super Admin (ven y editan todo).
// "tecnicoAdminEmails"        = Admin de Equipo técnico.
// "acomodadoresAdminEmails"   = Admin de Acomodadores.
// "asignacionesAdminEmails"   = Admin de Asignaciones (Programa).
// "territoriosAdminEmails"    = Admin de Territorios (territorios, grupos y salidas).
// "salonAdminEmails"          = Admin del Salón (trabajos del Salón y limpieza).
// "anunciosOnlyEmails"         = Solo anuncios (publican anuncios y nada más).
// "anunciosEmails"             = permiso extra "Puede publicar anuncios"
//                                para cualquiera de los tres Admin.
// "viewerEmails"               = solo pueden ver (ver.html).
//
// Qué controla el servidor:
//  · Estas reglas: un Admin solo puede cambiar las semanas ("weeks"),
//    y los anuncios si tiene el permiso. Ajustes, accesos, hermanos y
//    el cronómetro, solo el Super Admin.
//  · La función guardRoles (functions/index.js): dentro de las semanas,
//    que cada Admin toque solo su área (Equipo técnico, Acomodadores o
//    Programa). Si no, lo deshace al instante y lo anota en el Registro
//    de errores. Las reglas no pueden mirar tan adentro del documento.
//
// El primer email que crea una congregación nueva se agrega solo
// a "editorEmails" — así el que arma la congregación no queda
// afuera de su propia base.

service cloud.firestore {
  match /databases/{database}/documents {
    match /congregations/{code} {

      // Crear una congregación nueva: solo hace falta estar logueado.
      // La propia app agrega automáticamente el email de quien la
      // crea a editorEmails en el mismo momento de guardarla.
      allow create: if request.auth != null
                    && request.auth.token.email in request.resource.data.settings.editorEmails;

      function mail() { return request.auth.token.email; }
      function lista(campo) { return resource.data.settings.get(campo, []); }
      // (Antes, una congregación sin ningún Super Admin la podía abrir cualquiera con sesión:
      // era para las congregaciones de antes del login. Ya no hace falta y se cerró.)
      function esSuper() { return mail() in lista('editorEmails'); }
      function esAdmin() {
        return mail() in lista('tecnicoAdminEmails') ||
               mail() in lista('acomodadoresAdminEmails') ||
               mail() in lista('asignacionesAdminEmails');
      }
      function esSoloAnuncios() { return mail() in lista('anunciosOnlyEmails'); }
      function esTerritorios() { return mail() in lista('territoriosAdminEmails'); }
      function esSalon() { return mail() in lista('salonAdminEmails'); }
      function puedeAnuncios() { return esSuper() || esSoloAnuncios() || mail() in lista('anunciosEmails'); }
      // Qué partes del documento cambian en este guardado (primer nivel:
      // settings, publishers, weeks, anuncios, timerLog...).
      function soloCambia(campos) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
      }

      // Leer: logueado, y el email tiene que estar en alguna de las
      // listas de acceso de ESA congregación puntual (.get(..., []) por
      // si alguna lista todavía no existe).
      allow read: if request.auth != null && (
                    esSuper() || esAdmin() || esSoloAnuncios() || esTerritorios() || esSalon() ||
                    mail() in lista('viewerEmails')
                  );

      // Editar:
      //  · Super Admin: todo.
      //  · Admins (técnico / acomodadores / asignaciones): solo las
      //    semanas; y los anuncios si tienen el permiso "Puede publicar
      //    anuncios" (anunciosEmails). Qué parte de cada semana le toca a
      //    cada uno lo controla la función guardRoles.
      //  · "Solo anuncios": únicamente el campo de anuncios.
      allow update: if request.auth != null && (
                    esSuper() ||
                    (esAdmin() && (soloCambia(['weeks']) || (puedeAnuncios() && soloCambia(['weeks', 'anuncios'])))) ||
                    (esSoloAnuncios() && soloCambia(['anuncios'])) ||
                    ((esTerritorios() || esSalon()) && puedeAnuncios() && soloCambia(['anuncios']))
                  );

      // Nunca se borra una congregación completa desde la app.
      allow delete: if false;
    }

    // Registro de errores — si algo falla en la app o en la vista, se anota acá (sin datos
    // personales). Lo puede escribir cualquiera con acceso a la congregación; solo el Super
    // Admin lo lee y lo borra (Ajustes → Registro de errores). Nunca se modifica.
    match /congregations/{code}/errores/{id} {
      function ajustes() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function en(campo) { return request.auth.token.email in ajustes().get(campo, []); }
      allow create: if request.auth != null
                    && (en('editorEmails') || en('tecnicoAdminEmails') || en('acomodadoresAdminEmails') ||
                        en('asignacionesAdminEmails') || en('territoriosAdminEmails') || en('salonAdminEmails') || en('anunciosOnlyEmails') || en('viewerEmails'))
                    && request.resource.data.keys().hasOnly(['at', 'app', 'kind', 'msg', 'where', 'role', 'device', 'online'])
                    && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
                    && request.resource.data.get('where', '') is string && request.resource.data.get('where', '').size() <= 1000;
      allow read, delete: if request.auth != null && en('editorEmails');
      allow update: if false;
    }

    // Territorios, grupos de predicación y lugares de encuentro (documentos "grupos",
    // "lugares" y "territorios"). Los lee cualquiera con acceso (cada hermano ve en la
    // vista sus territorios y las salidas). Los cambian el Super Admin y el Admin de
    // Territorios; los lugares, también los encargados y auxiliares de grupo.
    match /congregations/{code}/terr/{docId} {
      function ajT() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function enT(c) { return request.auth.token.email in ajT().get(c, []); }
      function conAccesoT() {
        return enT('editorEmails') || enT('tecnicoAdminEmails') || enT('acomodadoresAdminEmails') ||
               enT('asignacionesAdminEmails') || enT('territoriosAdminEmails') || enT('salonAdminEmails') || enT('anunciosOnlyEmails') || enT('viewerEmails');
      }
      function gestorT() { return enT('editorEmails') || enT('territoriosAdminEmails'); }
      function encargadoDeGrupo() {
        let g = /databases/$(database)/documents/congregations/$(code)/terr/grupos;
        return exists(g) && request.auth.token.email in get(g).data.get('editoresTodos', []);
      }
      allow read: if request.auth != null && conAccesoT();
      allow write: if request.auth != null && (gestorT() || (docId == 'lugares' && encargadoDeGrupo()));
    }

    // Salidas al servicio: un documento por grupo ("congregacion" para las de toda la
    // congregación). Las ve cualquiera con acceso; las cambian el Super Admin, el Admin de
    // Territorios y, las de cada grupo, su encargado y su auxiliar.
    match /congregations/{code}/salidas/{gid} {
      function ajS() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function enS(c) { return request.auth.token.email in ajS().get(c, []); }
      function conAccesoS() {
        return enS('editorEmails') || enS('tecnicoAdminEmails') || enS('acomodadoresAdminEmails') ||
               enS('asignacionesAdminEmails') || enS('territoriosAdminEmails') || enS('salonAdminEmails') || enS('anunciosOnlyEmails') || enS('viewerEmails');
      }
      function editaGrupo() {
        let g = /databases/$(database)/documents/congregations/$(code)/terr/grupos;
        return gid != 'congregacion' && exists(g) &&
               request.auth.token.email in get(g).data.get('lista', {}).get(gid, {}).get('editores', []);
      }
      allow read: if request.auth != null && conAccesoS();
      allow write: if request.auth != null && (enS('editorEmails') || enS('territoriosAdminEmails') || editaGrupo());
    }

    // "Lo terminé": el hermano avisa desde la vista que terminó un territorio (un aviso por
    // territorio, con su propio email). Lo ven él y quien maneja territorios, que lo confirma
    // (y lo borra) desde la app de asignaciones.
    match /congregations/{code}/terminados/{tid} {
      function ajX() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function enX(c) { return request.auth.token.email in ajX().get(c, []); }
      function gestorX() { return enX('editorEmails') || enX('territoriosAdminEmails'); }
      function conAccesoX() {
        return gestorX() || enX('tecnicoAdminEmails') || enX('acomodadoresAdminEmails') ||
               enX('asignacionesAdminEmails') || enX('salonAdminEmails') || enX('anunciosOnlyEmails') || enX('viewerEmails');
      }
      function avisoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tid', 'pubId', 'nombre', 'email', 'fecha', 'at']) &&
               d.email == request.auth.token.email && d.tid == tid &&
               d.fecha is string && d.fecha.size() == 10 && d.nombre is string && d.nombre.size() <= 80;
      }
      allow create: if request.auth != null && conAccesoX() && avisoValido();
      allow update: if request.auth != null && resource.data.email == request.auth.token.email && avisoValido();
      allow read: if request.auth != null && (gestorX() || resource.data.email == request.auth.token.email);
      allow delete: if request.auth != null && gestorX();
    }

    // Salón: trabajos de mantenimiento ("trabajos"), limpieza por grupos ("limpieza") y
    // hermanos de otra congregación que ayudan cuando el Salón es compartido ("externos").
    // Los lee cualquiera con acceso (los hermanos los ven en la vista); los cambian el
    // Super Admin y el Admin del Salón.
    match /congregations/{code}/salon/{docId} {
      function ajL() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function enL(c) { return request.auth.token.email in ajL().get(c, []); }
      function conAccesoL() {
        return enL('editorEmails') || enL('tecnicoAdminEmails') || enL('acomodadoresAdminEmails') || enL('asignacionesAdminEmails') ||
               enL('territoriosAdminEmails') || enL('salonAdminEmails') || enL('anunciosOnlyEmails') || enL('viewerEmails');
      }
      // "externos": hermanos de otra congregación (salón compartido) con su teléfono; solo los ven quienes manejan el Salón.
      allow read: if request.auth != null && (docId == 'externos' ? (enL('editorEmails') || enL('salonAdminEmails')) : conAccesoL());
      allow write: if request.auth != null && (enL('editorEmails') || enL('salonAdminEmails')) && docId in ['trabajos', 'limpieza', 'externos'];
    }

    // "Me sumo": cada hermano se anota (o se da de baja) él mismo en un trabajo del Salón, con su
    // propio uid en el id del documento (trabajo__fecha__uid). Todos los de la congregación ven
    // quiénes van. El Super Admin y el Admin del Salón pueden quitar a cualquiera.
    match /congregations/{code}/salonAnotados/{aid} {
      function ajA() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function enA(c) { return request.auth.token.email in ajA().get(c, []); }
      function gestorA() { return enA('editorEmails') || enA('salonAdminEmails'); }
      function conAccesoA() {
        return gestorA() || enA('tecnicoAdminEmails') || enA('acomodadoresAdminEmails') || enA('asignacionesAdminEmails') ||
               enA('territoriosAdminEmails') || enA('anunciosOnlyEmails') || enA('viewerEmails');
      }
      function anotadoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tid', 'fecha', 'pubId', 'nombre', 'uid', 'comentario', 'at']) &&
               d.uid == request.auth.uid && aid == d.tid + '__' + d.fecha + '__' + request.auth.uid &&
               d.tid is string && d.tid.size() <= 40 && d.fecha is string && d.fecha.size() == 10 &&
               d.pubId is string && d.pubId.size() <= 40 && d.nombre is string && d.nombre.size() <= 80 &&
               d.get('comentario', '') is string && d.get('comentario', '').size() <= 80;
      }
      allow read: if request.auth != null && conAccesoA();
      allow create: if request.auth != null && conAccesoA() && anotadoValido();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && anotadoValido();
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || gestorA());
    }

    // Solicitudes de acceso — quien entra a la vista sin estar autorizado pide acceso con
    // su nombre. Un pedido por cuenta (el id es su uid), siempre con SU email (el del inicio
    // de sesión) y en estado "pendiente". Mientras está pendiente puede corregir el nombre.
    // El Super Admin los ve, los rechaza (status "rechazado") o los aprueba (lo agrega a
    // Acceso y borra el pedido).
    match /congregations/{code}/solicitudes/{uid} {
      function ajustesSol() { return get(/databases/$(database)/documents/congregations/$(code)).data.settings; }
      function esSuperSol() { return request.auth.token.email in ajustesSol().get('editorEmails', []); }
      function pedidoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'name', 'createdAt', 'updatedAt', 'status']) &&
               d.email == request.auth.token.email &&
               d.name is string && d.name.size() >= 3 && d.name.size() <= 80 &&
               d.status == 'pendiente' &&
               d.createdAt is string && d.updatedAt is string;
      }
      allow create: if request.auth != null && request.auth.uid == uid && pedidoValido();
      allow update: if request.auth != null && (
                    esSuperSol() ||
                    (request.auth.uid == uid && resource.data.status == 'pendiente' && pedidoValido() &&
                     request.resource.data.createdAt == resource.data.createdAt)
                  );
      allow read: if request.auth != null && (request.auth.uid == uid || esSuperSol());
      allow delete: if request.auth != null && esSuperSol();
    }

    // Notificaciones push — un documento por celular/token, para
    // avisar por asignación nueva. Separado del documento principal
    // a propósito: así no hace falta tocar las reglas de arriba, y
    // cualquier persona logueada (ya haya pasado el control de
    // acceso de su congregación) puede registrar o borrar su propio
    // token sin exponer nada del resto de los datos.
    match /pushSubscriptions/{token} {
      allow read: if false; // solo la función en la nube los lee (con permisos de administrador, salta las reglas)
      allow write: if request.auth != null
                   && request.resource.data.keys().hasAll(['code', 'pubId'])
                   && request.resource.data.code is string
                   && request.resource.data.pubId is string;
      allow delete: if request.auth != null;
    }
  }
}
